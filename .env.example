# PostgreSQL ReplicaStore configuration (not a core database dependency).
# Provision an independent database; operator setup is documented in docs/operator-setup.md.
DATABASE_URL=postgresql://user:password@localhost:5432/replcrm
# Must reference an existing Deployment row; see docs/operator-setup.md.
DEPLOYMENT_ID=

# Salesforce source (password + security token authentication)
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=user@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token

# Core replication. Use * to discover queryable source objects.
SYNC_BATCH_SIZE=2000
SYNC_ENTITIES=Account,Contact,Lead,Opportunity,Case
SYNC_ENTITY_DENY=
BUILD_WIDE_VIEWS=true
