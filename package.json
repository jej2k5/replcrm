{
  "name": "replcrm",
  "version": "0.1.0",
  "private": true,
  "description": "Metadata-driven CRM replication engine with source-neutral adapters and pluggable replica stores.",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate": "tsx src/cli.ts",
    "migrate:metadata": "tsx src/cli.ts metadata",
    "migrate:records": "tsx src/cli.ts records",
    "migrate:full": "tsx src/cli.ts full",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --project tsconfig.tests.json",
    "replicate": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "decimal.js": "^10.4.3",
    "jsforce": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "crm",
    "replication",
    "metadata",
    "salesforce",
    "postgresql",
    "replica-store"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "author": "HONA LLC"
}
